{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Negotiate Contract Output",
  "type": "object",
  "required": ["agreement", "agreement_hash", "negotiation_log", "status"],
  "properties": {
    "agreement": {
      "type": "object",
      "required": ["price", "asset", "asset_type", "delivery_requirements", "payment_amount", "payment_token", "deadlines", "cancellation_policy", "settlement_conditions", "buyer", "seller", "marketplace_id", "negotiation_id", "timestamp", "version"],
      "properties": {
        "price": {
          "type": "number",
          "description": "Final agreed price in base units",
          "minimum": 1
        },
        "asset": {
          "type": "string",
          "description": "Asset/service identifier",
          "minLength": 1
        },
        "asset_type": {
          "type": "string",
          "enum": ["service", "digital_good", "physical_good", "compute"],
          "description": "Type of asset"
        },
        "delivery_requirements": {
          "type": "object",
          "required": ["method", "deadline", "verification", "details"],
          "properties": {
            "method": {
              "type": "string",
              "enum": ["digital", "physical", "api"],
              "description": "Delivery method"
            },
            "deadline": {
              "type": "number",
              "description": "Unix timestamp for delivery deadline",
              "minimum": 1
            },
            "verification": {
              "type": "string",
              "enum": ["automatic", "manual", "zk_proof"],
              "description": "Verification method"
            },
            "details": {
              "type": "string",
              "description": "Delivery details"
            }
          }
        },
        "payment_amount": {
          "type": "number",
          "description": "Total payment amount in base units",
          "minimum": 1
        },
        "payment_token": {
          "type": "string",
          "description": "Token mint address or 'SOL'"
        },
        "deadlines": {
          "type": "object",
          "required": ["delivery", "payment", "dispute_window", "expiration"],
          "properties": {
            "delivery": {
              "type": "number",
              "description": "Delivery deadline timestamp",
              "minimum": 1
            },
            "payment": {
              "type": "number",
              "description": "Payment deadline timestamp",
              "minimum": 1
            },
            "dispute_window": {
              "type": "number",
              "description": "Dispute window end timestamp",
              "minimum": 1
            },
            "expiration": {
              "type": "number",
              "description": "Agreement expiration timestamp",
              "minimum": 1
            }
          }
        },
        "cancellation_policy": {
          "type": "object",
          "required": ["buyer_can_cancel", "seller_can_cancel", "cancellation_window_seconds", "refund_policy", "penalty_basis_points"],
          "properties": {
            "buyer_can_cancel": {
              "type": "boolean"
            },
            "seller_can_cancel": {
              "type": "boolean"
            },
            "cancellation_window_seconds": {
              "type": "number",
              "minimum": 0
            },
            "refund_policy": {
              "type": "string",
              "enum": ["full", "partial", "none"]
            },
            "penalty_basis_points": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "settlement_conditions": {
          "type": "object",
          "required": ["auto_release_on_delivery", "require_buyer_confirmation", "dispute_resolution", "preimage_reveal_required"],
          "properties": {
            "auto_release_on_delivery": {
              "type": "boolean"
            },
            "require_buyer_confirmation": {
              "type": "boolean"
            },
            "dispute_resolution": {
              "type": "string",
              "enum": ["mutual", "arbitration", "platform"]
            },
            "preimage_reveal_required": {
              "type": "boolean"
            }
          }
        },
        "buyer": {
          "type": "string",
          "description": "Buyer public key (base58)"
        },
        "seller": {
          "type": "string",
          "description": "Seller public key (base58)"
        },
        "marketplace_id": {
          "type": "string",
          "description": "Marketplace identifier"
        },
        "negotiation_id": {
          "type": "string",
          "description": "Negotiation session ID"
        },
        "timestamp": {
          "type": "number",
          "description": "Unix timestamp when agreement finalized",
          "minimum": 1
        },
        "version": {
          "type": "number",
          "description": "Agreement schema version",
          "const": 1
        }
      }
    },
    "agreement_hash": {
      "type": "string",
      "description": "SHA-256 hash of the deterministic agreement (hex encoded, 64 chars)",
      "pattern": "^[0-9a-f]{64}$"
    },
    "negotiation_log": {
      "type": "array",
      "description": "Log of negotiation rounds",
      "items": {
        "type": "object",
        "required": ["round", "buyer_position", "seller_position", "outcome"],
        "properties": {
          "round": {
            "type": "number",
            "description": "Negotiation round number"
          },
          "buyer_position": {
            "type": "object",
            "description": "Buyer's position in this round"
          },
          "seller_position": {
            "type": "object",
            "description": "Seller's position in this round"
          },
          "outcome": {
            "type": "string",
            "enum": ["counter", "accepted", "rejected", "failed"],
            "description": "Outcome of this round"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["success", "failed", "price_mismatch", "asset_mismatch", "token_mismatch", "validation_error"],
      "description": "Negotiation outcome status"
    },
    "error_message": {
      "type": "string",
      "description": "Error message if negotiation failed"
    }
  }
}